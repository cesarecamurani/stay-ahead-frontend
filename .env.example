# API base URL for production builds only.
# In local dev (npm run dev), requests use the Vite proxy automatically — leave this empty.
VITE_API_BASE_URL=

# Vite dev proxy target. Must match the port your Rails server listens on.
# Default Rails port is 3000; use 9000 if you start with `bin/rails server -p 9000`.
VITE_API_PROXY_TARGET=http://localhost:3000
